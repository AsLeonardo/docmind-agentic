# Qualquer API compatível com OpenAI.
# Gemini (gratuito, chat + embeddings): https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_CHAT_MODEL=gemini-2.5-flash

# Embeddings: por padrão usam a mesma chave e URL acima.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# Exemplo: chat no Groq (mais rápido) e embeddings no Gemini
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_CHAT_MODEL=llama-3.3-70b-versatile
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBEDDING_API_KEY=...

# Gere um valor aleatório: openssl rand -base64 48
JWT_SECRET=
DB_PASSWORD=docmind
